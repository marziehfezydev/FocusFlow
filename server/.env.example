# ── Accounts ──
# Max number of accounts that can ever be created (default 2: you + one friend)
MAX_USERS=2
# Optional but recommended if the app is on the internet: registration needs this code
INVITE_CODE=
# Optional: secret used to sign login tokens (auto-generated into data/secret.key if empty)
FOCUSFLOW_SECRET=

# ── Storage ──
# Where user data is saved. When hosting, point this at a persistent disk/volume.
DATA_DIR=

# ── AI (optional) ──
# Enables Claude-powered coaching. Without it, a built-in offline coach is used.
ANTHROPIC_API_KEY=
FOCUSFLOW_MODEL=

PORT=4000
