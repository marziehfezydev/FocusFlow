# ── Accounts ──
# Max number of accounts that can ever be created (default 2: you + one friend)
MAX_USERS=2
# Optional but recommended if the app is on the internet: registration needs this code
INVITE_CODE=
# Optional: secret used to sign login tokens (auto-generated into data/secret.key if empty)
FOCUSFLOW_SECRET=

# ── Storage ──
# Where user data is saved. When hosting, point this at a persistent disk/volume.
DATA_DIR=

# ── AI (optional) ──
# Enables Claude-powered coaching. Without it, a built-in offline coach is used.
ANTHROPIC_API_KEY=
FOCUSFLOW_MODEL=

PORT=4000

# ── Hosted database (needed on Vercel, optional elsewhere) ──
# Create a free Upstash Redis (Vercel → Storage) and connect it to the project; these are then set for you.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (KV_REST_API_URL / KV_REST_API_TOKEN are also understood)

# Public demo: how many one-click "Try the demo" guest worlds may be created per day. 0 = off.
# Guests are deleted after 7 days. Only works with the hosted database.
# MAX_GUESTS=20